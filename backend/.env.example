# Copy to environment variables or a local, untracked .env file.
# Do not commit real credentials.

DATABASE_URL=jdbc:postgresql://localhost:5432/workout_tracker
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change_me

SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Session cookie Secure flag. Keep false for local HTTP development.
# For HTTPS production, set true or activate the prod Spring profile.
SESSION_COOKIE_SECURE=false
