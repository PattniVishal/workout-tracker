# Copy to environment variables or a local, untracked .env file.
# Do not commit real credentials.

DATABASE_URL=jdbc:postgresql://localhost:5432/workout_tracker
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change_me

SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Session cookie settings. Keep false/lax for local HTTP development.
# For HTTPS production, set SESSION_COOKIE_SECURE=true and activate the prod profile.
# For cross-site frontend/API domains over HTTPS, use SESSION_COOKIE_SAME_SITE=none with Secure=true.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
