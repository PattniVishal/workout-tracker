# Copy to .env in the repository root for Docker Compose (production-like local stack).
# Do not commit real credentials.

# Public entry point (maps host port → nginx container port 80)
COMPOSE_HTTP_PORT=8080

# PostgreSQL (Docker Compose service — internal only, not published to host)
POSTGRES_DB=workout_tracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Backend database connection (Spring Boot — uses Compose service hostname)
DATABASE_URL=jdbc:postgresql://postgres:5432/workout_tracker
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change-me

# Backend (same-origin through nginx)
SPRING_PROFILES_ACTIVE=
CORS_ALLOWED_ORIGINS=http://localhost:8080
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax

# Frontend build argument (relative API path for same-origin requests)
VITE_API_BASE_URL=/api
